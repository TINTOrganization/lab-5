        <mxCell id="dUxDPcMC67rqybFAgTAm-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;component-1: nginx&lt;/b&gt;&lt;div&gt;&lt;b&gt;Reverse Proxy &amp;amp; Ingress Gateway&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;Responsabilidades Asignadas&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- Terminación TLS (HTTPS en puerto :8443)&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- Redirección HTTP (puerto :8080 -&amp;gt; 301 a :8443)&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- Inyección de cabeceras de proxy y seguridad&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- Balanceo de carga round-robin y failover&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- Caché de respuestas (proxy_cache) y gzip&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- Conexiones HTTP keep-alive hacia upstream&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;Servidor de archivos estáticos (/static)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;(servido directamente por ngnix desde disco, sin consultar ningún upstream de backend)&lt;br&gt;&lt;/div&gt;" vertex="1">
