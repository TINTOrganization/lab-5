        <mxCell id="lp8rrmTQlUyto8URFB2u-1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;component-1: nginx&lt;/b&gt;&lt;div&gt;&lt;b&gt;Pasarela Dual-Homed&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;Toca ambas redes:&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;1. Red edge (eth0)&lt;/div&gt;&lt;div style=&quot;&quot;&gt;2. Red internal (eth1)&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;Puertos escuchando:&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- :8443 (TLS terminada)&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- :8080 (Redirect 301)&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- Enrutamiento upstream&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- Caché y /static local (servido desde disco)&lt;/div&gt;" vertex="1">
